---
import { getTeamMembers } from "@lib/api";
import type { TeamMember } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import ArrowLeft from "@icons/arrow-left.svg";

interface Props {
  employee: TeamMember;
}

export async function getStaticPaths() {
  const team = await getTeamMembers();

  return team.map((employee) => ({
    params: { slug: employee.slug },
    props: { employee },
  }));
}

const { employee } = Astro.props;

// Sociale links: kun rigtige URL'er er klikbare – #-links vises som
// ikke-aktive ikoner (aldrig som døde links).
const iconFiles = import.meta.glob<string>("/src/icons/*.svg", {
  eager: true,
  query: "?url",
  import: "default",
});

const socialIcons = (employee.social_links ?? [])
  .map((link) => ({
    label: link.platform,
    url: link.url,
    icon: iconFiles[`/src/icons/${link.icon}.svg`],
    active: Boolean(link.url && link.url !== "#"),
  }))
  .filter((social) => Boolean(social.icon));
---

<Layout>
  <main class="team-profile">
    <div class="profile-inner">
      <nav
        class="back-nav"
        aria-label="Back to team"
      >
        <a href="/team">
          <ArrowLeft
            class="arrow"
            aria-hidden="true"
          />
          Back to team
        </a>
      </nav>

      <div class="profile-grid">
        <div class="profile-portrait">
          <span
            class="green-box"
            aria-hidden="true"
          ></span>

          <Image
            class="profile-image"
            src={employee.image.src}
            alt={employee.image.alt}
            width={employee.image.width}
            height={employee.image.height}
          />
        </div>

        <div class="profile-content">
          <p class="profile-role">{employee.title}</p>

          <h1 class="profile-name">{employee.name}</h1>

          {
            employee.description && (
              <p class="profile-intro">{employee.description}</p>
            )
          }

          {
            employee.description_long && (
              <p class="profile-text">{employee.description_long}</p>
            )
          }

          {
            employee.past_experience && (
              <section
                class="profile-section"
                aria-labelledby="experience-heading"
              >
                <h2 id="experience-heading">Past Experience</h2>
                <p>{employee.past_experience}</p>
              </section>
            )
          }

          {
            socialIcons.length > 0 && (
              <div class="profile-socials">
                {socialIcons.map((social) =>
                  social.active ? (
                    <a
                      href={social.url}
                      aria-label={social.label}
                    >
                      <img
                        src={social.icon}
                        alt=""
                        width="18"
                        height="18"
                        loading="lazy"
                      />
                    </a>
                  ) : (
                    <span
                      class="social-icon"
                      aria-hidden="true"
                    >
                      <img
                        src={social.icon}
                        alt=""
                        width="18"
                        height="18"
                        loading="lazy"
                      />
                    </span>
                  ),
                )}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .team-profile {
    width: 100%;
  }

  .profile-inner {
    width: min(75rem, 100%);
    margin-inline: auto;
    padding: var(--space-5) 2rem var(--space-7);
    box-sizing: border-box;
  }

  /* Tilbage-navigation */

  .back-nav {
    margin-bottom: var(--space-5);
  }

  .back-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font: var(--body-sm);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-nav a:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .back-nav a:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .back-nav .arrow {
    flex: 0 0 1rem;
    width: 1rem;
    height: 1rem;
  }

  /* Afbalanceret to-kolonne-layout: portræt mindre end teksten */

  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  /* Portræt med grøn dekorativ boks bag billedet */

  .profile-portrait {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 0.75rem;
    border-radius: 20px;
    min-width: 0;
  }

  .profile-portrait .green-box {
    position: absolute;
    z-index: 0;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 7rem;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    background-color: var(--color-green-400);
  }

  .profile-image {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    border-radius: 14px;
    background: var(--color-surface-tertiary);
  }

  /* Indholdshierarki: titel → navn → intro → sektioner */

  .profile-content {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    min-width: 0;
  }

  .profile-role {
    margin: 0;
    color: var(--color-blue-700);
    font: var(--body-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .profile-name {
    margin: 0;
    color: var(--color-text);
    font: var(--heading-lg);
    letter-spacing: -0.03em;
  }

  .profile-intro {
    margin: 0;
    max-width: 60ch;
    color: var(--color-text);
    font: var(--body-lg);
    line-height: 1.7;
  }

  .profile-text {
    margin: 0;
    max-width: 65ch;
    color: var(--color-text-muted);
    font: var(--body-lg);
    line-height: 1.8;
  }

  .profile-section {
    display: grid;
    gap: var(--space-3);
  }

  .profile-section h2 {
    margin: 0;
    color: var(--color-text);
    font: var(--heading-sm);
  }

  .profile-section p {
    margin: 0;
    max-width: 65ch;
    color: var(--color-text-muted);
    font: var(--body-lg);
    line-height: 1.8;
  }

  /* Sociale ikoner – klikbare når URL'en er gyldig, dæmpet ellers */

  .profile-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: var(--space-1);
  }

  .profile-socials a,
  .profile-socials .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-blue-700);
    transition: opacity 0.2s ease;
  }

  .profile-socials a:hover {
    opacity: 0.8;
  }

  .profile-socials a:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 3px;
  }

  .profile-socials .social-icon {
    opacity: 0.45;
  }

  .profile-socials img {
    display: block;
    width: 18px;
    height: 18px;
    filter: brightness(0) invert(1);
  }

  /* Tablet – enkelt kolonnelayout */

  @media (max-width: 900px) {
    .profile-inner {
      padding-block: var(--space-4) var(--space-6);
    }

    .profile-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .profile-portrait {
      max-width: 32rem;
    }
  }

  /* Mobil */

  @media (max-width: 600px) {
    .profile-inner {
      padding: var(--space-4) 1.5rem var(--space-6);
    }

    .profile-portrait {
      max-width: 100%;
      padding: 0.5rem;
      border-radius: var(--radius-md);
    }

    .profile-portrait .green-box {
      width: 5rem;
      border-radius: var(--radius-sm);
    }

    .profile-image {
      aspect-ratio: 1 / 1;
    }

    .profile-content {
      gap: var(--space-3);
    }
  }
</style>

