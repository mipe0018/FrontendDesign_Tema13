<button
    class="login-button"
    type="button"
    popovertarget="login-popover"
    aria-controls="login-popover"
>
    Login
</button>

<div
    id="login-popover"
    class="login-popover"
    popover="auto"
>
    <div class="login-content">
        <h2>Dashboard Login</h2>

        <form>
            <label for="login-email">Email address</label>
            <input
                id="login-email"
                name="email"
                type="email"
                autocomplete="email"
                required
            />

            <label for="login-password">Password</label>
            <input
                id="login-password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
            />

            <button
                class="dashboard-button"
                type="submit"
            >
                Go to dashboard
            </button>
        </form>
    </div>
</div>

<style>
    @layer components {
        /* Login-knappen */
        .login-button {
            padding: 0.7rem 1.6rem;
            border: none;
            border-radius: 999px;
            background: #ffffff;
            color: var(--color-neutrals-900);
            font: inherit;
            font-size: 0.85rem;
            font-weight: 700;
            line-height: 1;
            cursor: pointer;
        }

        .login-button:hover,
        .login-button:focus-visible {
            background: var(--color-action);
        }

        /* Login-vinduet */
        .login-popover {
            position: fixed;
            inset: auto;
            top: 5rem;
            right: 1rem;
            width: min(350px, calc(100vw - 2rem));
            box-sizing: border-box;
            padding: 0;
            border: none;
            border-radius: 1.25rem;
            background: #ffffff;
            color: var(--color-neutrals-900);
            box-shadow: 0 1rem 3rem rgb(0 0 0 / 15%);
        }

        /* Placer vinduet under Login-knappen */
        @supports (top: anchor(bottom)) {
            .login-button {
                anchor-name: --login-button;
            }

            .login-popover {
                position-anchor: --login-button;
                top: anchor(bottom);
                right: anchor(right);
                margin-top: 0.6rem;
            }
        }

        .login-content {
            padding: 2rem;
        }

        .login-content h2 {
            margin: 0 0 1.5rem;
            font-size: 2rem;
            line-height: 1.1;
        }

        .login-content form {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .login-content label {
            margin-top: 0.4rem;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .login-content input {
            width: 100%;
            box-sizing: border-box;
            padding: 0.75rem 1rem;
            border: 1px solid var(--color-neutrals-200);
            border-radius: 999px;
            background: var(--color-surface-secondary);
            color: var(--color-neutrals-900);
            font: inherit;
        }

        .login-content input:focus-visible {
            outline: 2px solid var(--color-action);
            outline-offset: 2px;
        }

        .dashboard-button {
            width: 100%;
            margin-top: 1rem;
            padding: 0.85rem 1rem;
            border: none;
            border-radius: 999px;
            background: var(--color-action);
            color: var(--color-neutrals-900);
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .dashboard-button:hover {
            background: var(--color-yellow-600);
        }

        @media (max-width: 450px) {
            .login-popover {
                right: 1rem;
                width: calc(100vw - 2rem);
            }

            .login-content {
                padding: 1.5rem;
            }
        }
    }
</style>
