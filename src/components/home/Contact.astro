---
import { Image } from "astro:assets";

import ContactImgOne from "@assets/images/contactimg1.png";
import ContactImgTwo from "@assets/images/contactimg2.png";
import ContactImgThree from "@assets/images/contactimg3.png";

import IconPhone from "@icons/phone.svg";
import IconClock from "@icons/clock.svg";
import IconPin from "@icons/pin.svg";

const contactDetails = [
    {
        title: "Call Today",
        value: "+1 800 100 900",
        type: "phone",
        icon: IconPhone,
    },
    {
        title: "Monday To Friday",
        value: "9AM - 5PM",
        type: "hours",
        icon: IconClock,
    },
    {
        title: "USA Office",
        value: "195 Devonshire St Boston, MA 02110",
        type: "address",
        icon: IconPin,
    },
];
---

<section
    class="contact-info"
    id="contact"
    aria-labelledby="contact-title"
>
    <div class="contact-info-inner">
        <div class="info-text">
            <p class="eyebrow">Process</p>

            <h2 id="contact-title">Contact Us. It’s Easy.</h2>

            <p class="contact-description">
                Leverage agile frameworks to provide a robust synopsis for high
                level overviews. Iterative approaches to corporate strategy
                foster collaborative.
            </p>

            <address class="contact-details">
                {
                    contactDetails.map((detail) => (
                        <div class="info-icon">
                            <div
                                class={`icon-circle ${detail.type}-circle`}
                                aria-hidden="true"
                            >
                                <Image
                                    class="contact-icon"
                                    src={detail.icon}
                                    alt=""
                                />
                            </div>

                            <div class="icon-text">
                                <h3>{detail.title}</h3>
                                <p>{detail.value}</p>
                            </div>
                        </div>
                    ))
                }
            </address>
        </div>

        <div class="contact-image contact-image-large">
            <div
                class="green-box"
                aria-hidden="true"
            >
            </div>

            <Image
                class="contact-img"
                src={ContactImgOne}
                alt="Consulting team collaborating"
                loading="lazy"
            />
        </div>

        <div class="contact-image contact-image-small">
            <Image
                class="contact-img"
                src={ContactImgTwo}
                alt="Consulting workspace"
                loading="lazy"
            />
        </div>

        <div class="contact-image contact-image-small">
            <Image
                class="contact-img"
                src={ContactImgThree}
                alt="Business meeting"
                loading="lazy"
            />
        </div>
    </div>
</section>

<style>
    @layer components {
        .contact-info {
            grid-column: a / d;
            width: 100%;
            min-width: 0;
            margin-block-start: clamp(5rem, 10vw, 10rem);
            /* Plads til den ud-stikkende grønne dekoration, så sektionen
               afslutter naturligt før footeren */
            padding-block-end: 1rem;
        }

        .contact-info-inner {
            display: grid;
            grid-template-columns:
                minmax(0, 1.1fr)
                minmax(0, 1fr)
                minmax(0, 0.8fr);
            grid-template-rows: repeat(2, minmax(200px, 1fr));
            align-items: stretch;
            gap: clamp(0.75rem, 1.5vw, 1rem);
            width: min(75rem, 100%);
            box-sizing: border-box;
            margin-inline: auto;
            padding-inline: 1rem;
            container-type: inline-size;
        }

        /* Tekst og kontaktoplysninger */

        .info-text {
            grid-column: 1;
            grid-row: 1 / 3;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-width: 0;
            padding-inline-end: 1rem;
        }

        .eyebrow {
            margin: 0 0 0.5rem;
            font: var(--body-sm);
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .info-text > h2 {
            margin: 0 0 1rem;
            font: var(--heading-lg);
            letter-spacing: -0.03em;
            text-wrap: balance;
        }

        .contact-description {
            margin: 0 0 2rem;
            color: var(--color-text-muted);
            font: var(--body-lg);
            line-height: 1.6;
        }

        .contact-details {
            display: grid;
            gap: 1.25rem;
            margin: 0;
            font-style: normal;
        }

        .info-icon {
            display: grid;
            grid-template-columns: 3.25rem minmax(0, 1fr);
            align-items: center;
            gap: 0.875rem;
            min-width: 0;
        }

        .icon-circle {
            display: grid;
            width: 3.25rem;
            aspect-ratio: 1;
            place-items: center;
            border-radius: 50%;
        }

        .phone-circle {
            background-color: var(--color-green-400);
        }

        .hours-circle {
            background-color: #e8a15b;
        }

        .address-circle {
            background-color: #b5b5b5;
        }

        .contact-icon {
            display: block;
            width: 1.5rem;
            height: 1.5rem;
            object-fit: contain;
        }

        .icon-text {
            display: grid;
            gap: 0.2rem;
            min-width: 0;
        }

        .icon-text h3,
        .icon-text p {
            margin: 0;
            overflow-wrap: anywhere;
        }

        .icon-text h3 {
            color: var(--color-text-muted);
            font: var(--body-lg);
        }

        .icon-text p {
            color: var(--color-text);
            font: var(--button-lg);
            line-height: 1.5;
        }

        /* Billedlayout */

        .contact-image {
            position: relative;
            min-width: 0;
            min-height: 0;
            overflow: visible;
        }

        .contact-image-large {
            grid-column: 2;
            grid-row: 1 / 3;
            isolation: isolate;
        }

        .contact-image-small:first-of-type {
            grid-column: 3;
            grid-row: 1;
        }

        .contact-image-small:last-of-type {
            grid-column: 3;
            grid-row: 2;
        }

        .contact-img {
            display: block;
            width: 100%;
            height: 100%;
            border-radius: 25px;
            object-fit: cover;
        }

        .contact-image-large .contact-img {
            position: relative;
            z-index: 1;
        }

        .green-box {
            position: absolute;
            z-index: 0;
            inset-inline-start: -1rem;
            inset-block-end: -0.75rem;
            width: min(75%, 20rem);
            height: 9rem;
            border-radius: 25px;
            background-color: var(--color-green-400);
        }

        /* Tablet */

        @media (max-width: 900px) {
            .contact-info-inner {
                grid-template-columns:
                    minmax(0, 1fr)
                    minmax(0, 1fr);
                grid-template-rows: auto 220px 220px;
                gap: 1.25rem;
                width: calc(100% - 3rem);
            }

            .info-text {
                grid-column: 1;
                grid-row: 1 / 4;
                padding-inline-end: 0;
            }

            .contact-image-large {
                grid-column: 2;
                grid-row: 1 / 3;
            }

            .contact-image-small:first-of-type {
                grid-column: 2;
                grid-row: 3;
            }

            .contact-image-small:last-of-type {
                display: none;
            }

            .icon-circle {
                width: 2.75rem;
            }

            .info-icon {
                grid-template-columns: 2.75rem minmax(0, 1fr);
                gap: 0.75rem;
            }

            .contact-icon {
                width: 1.25rem;
                height: 1.25rem;
            }

            .green-box {
                width: 65%;
                height: 5rem;
            }
        }

        /* Mobil */

        @media (max-width: 600px) {
            .contact-info-inner {
                grid-template-columns: minmax(0, 1fr);
                grid-template-rows: auto;
                width: 100%;
                padding-inline: 1.25rem;
                gap: 1.5rem;
            }

            .info-text {
                grid-column: 1;
                grid-row: auto;
            }

            .contact-description {
                margin-block-end: 1.5rem;
            }

            .contact-details {
                gap: 1rem;
            }

            .contact-image-large,
            .contact-image-small:first-of-type,
            .contact-image-small:last-of-type {
                display: block;
                grid-column: 1;
                grid-row: auto;
            }

            .contact-image-large .contact-img {
                aspect-ratio: 4 / 3;
                height: auto;
            }

            .contact-image-small .contact-img {
                aspect-ratio: 3 / 2;
                height: auto;
            }

            .green-box {
                inset-inline-start: -0.5rem;
                inset-block-end: -0.5rem;
                width: 45%;
                height: 4rem;
                border-radius: 20px;
            }
        }
    }
</style>
