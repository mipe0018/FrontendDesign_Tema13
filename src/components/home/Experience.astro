---
interface ExperienceStat {
    label: string;
    value: number;
}

interface ExperienceData {
    eyebrow: string;
    title: string;
    subtitle: string;
    stats: ExperienceStat[];
}

const response = await fetch("https://ftk-api.pages.dev/experience");

if (!response.ok) {
    throw new Error(`Kunne ikke hente experience-data: ${response.status}`);
}

const experienceData = (await response.json()) as ExperienceData;

// Begræns værdierne til 0–100, da de vises som procenter.
const stats = experienceData.stats.map((stat) => ({
    ...stat,
    value: Math.min(100, Math.max(0, stat.value)),
}));
---

<section
    class="experience"
    aria-labelledby="experience-title"
>
    <div class="experience-inner">
        <div class="experience-content">
            <p class="eyebrow">{experienceData.eyebrow}</p>

            <h2 id="experience-title">{experienceData.title}</h2>

            <p class="experience-subtitle">{experienceData.subtitle}</p>
        </div>

        <div
            class="experience-stats"
            aria-label="Statistik"
        >
            {
                stats.map((stat) => (
                    <figure
                        class="stat-card"
                        data-target={stat.value}
                        data-value="0"
                        aria-label={`${stat.label}: ${stat.value}%`}
                    >
                        <div class="stat-graphic">
                            <svg
                                viewBox="0 0 100 100"
                                aria-hidden="true"
                            >
                                <circle
                                    class="track"
                                    cx="50"
                                    cy="50"
                                    r="46"
                                />
                                <circle
                                    class="progress"
                                    cx="50"
                                    cy="50"
                                    r="46"
                                    pathLength="100"
                                    stroke-dasharray="0 100"
                                />
                                <circle
                                    class="marker"
                                    cx="96"
                                    cy="50"
                                    r="3"
                                />
                            </svg>
                        </div>

                        <figcaption>{stat.label}</figcaption>
                    </figure>
                ))
            }
        </div>
    </div>
</section>

<script>
    const initializedSections = new WeakSet<HTMLElement>();

    function setStatValue(figure: HTMLElement, value: number) {
        const progress = figure.querySelector<SVGCircleElement>(".progress");
        const marker = figure.querySelector<SVGCircleElement>(".marker");

        const clampedValue = Math.min(100, Math.max(0, value));

        figure.dataset.value = String(Math.round(clampedValue));

        if (!progress || !marker) return;

        // Opdaterer cirklens synlige længde.
        progress.style.strokeDasharray = `${clampedValue} 100`;

        // Beregner markørens position på cirklen.
        // SVG'en roteres -90 grader, så 0 % starter øverst.
        const angle = (clampedValue / 100) * Math.PI * 2;
        const radius = 46;
        const center = 50;

        const x = center + radius * Math.cos(angle);
        const y = center + radius * Math.sin(angle);

        marker.setAttribute("cx", String(x));
        marker.setAttribute("cy", String(y));
    }

    function initializeExperienceStats() {
        const sections = document.querySelectorAll<HTMLElement>(".experience");

        sections.forEach((section) => {
            if (initializedSections.has(section)) return;

            initializedSections.add(section);

            const figures = section.querySelectorAll<HTMLElement>(".stat-card");

            const animateFigure = (figure: HTMLElement) => {
                const target = Number(figure.dataset.target);

                if (!Number.isFinite(target)) return;

                if (
                    window.matchMedia("(prefers-reduced-motion: reduce)")
                        .matches
                ) {
                    setStatValue(figure, target);
                    return;
                }

                const duration = 1200;
                let startTime: number | undefined;

                const animate = (timestamp: number) => {
                    if (startTime === undefined) {
                        startTime = timestamp;
                    }

                    const progress = Math.min(
                        (timestamp - startTime) / duration,
                        1,
                    );

                    // Ease-out: Hurtig i starten, langsommere til sidst.
                    const easedProgress = 1 - Math.pow(1 - progress, 3);

                    setStatValue(figure, target * easedProgress);

                    if (progress < 1) {
                        requestAnimationFrame(animate);
                    } else {
                        setStatValue(figure, target);
                    }
                };

                requestAnimationFrame(animate);
            };

            if (!("IntersectionObserver" in window)) {
                figures.forEach(animateFigure);
                return;
            }

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;

                        const figure = entry.target as HTMLElement;

                        observer.unobserve(figure);
                        animateFigure(figure);
                    });
                },
                { threshold: 0.35 },
            );

            figures.forEach((figure) => observer.observe(figure));
        });
    }

    // Initial sidevisning.
    initializeExperienceStats();

    // Nye sider via Astro View Transitions.
    document.addEventListener("astro:page-load", initializeExperienceStats);
</script>

<style>
    @layer components {
        .experience {
            grid-column: a / d;
            width: 100%;
            box-sizing: border-box;
            margin-block-start: 6rem;
            background-color: var(--color-surface-highlight, #f1e689);
            color: var(--color-text, #171717);
        }

        .experience-inner {
            display: grid;
            grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
            align-items: center;
            gap: clamp(2rem, 5vw, 4rem);
            width: min(100%, 1200px);
            min-height: 300px;
            box-sizing: border-box;
            margin-inline: auto;
            padding: clamp(2rem, 5vw, 3.5rem) 2rem;
        }

        .experience-content {
            min-width: 0;
            max-width: 390px;
        }

        .experience-content .eyebrow {
            margin: 0 0 1rem;
            font: var(--body-sm);
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .experience-content h2 {
            margin: 0;
            font: var(--heading-lg);
            letter-spacing: -0.03em;
            line-height: 1.15;
            text-wrap: balance;
        }

        .experience-subtitle {
            margin: 1rem 0 0;
            font: var(--body-lg);
            line-height: 1.6;
            color: var(--color-text, #171717);
            opacity: 0.9;
        }

        .experience-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            align-items: start;
            gap: clamp(1rem, 2.5vw, 2rem);
            min-width: 0;
        }

        .stat-card {
            display: grid;
            grid-template-areas:
                "stat"
                "label";
            justify-items: center;
            min-width: 0;
            margin: 0;
            container-type: inline-size;
        }

        .stat-card::before {
            content: attr(data-value) "%";
            grid-area: stat;
            z-index: 1;
            display: grid;
            place-items: center;
            font-size: 24cqw;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }

        .stat-graphic {
            grid-area: stat;
            width: min(100%, 150px);
            aspect-ratio: 1;
        }

        .stat-graphic svg {
            display: block;
            width: 100%;
            height: 100%;
            overflow: visible;
            transform: rotate(-90deg);
        }

        .track,
        .progress {
            fill: none;
            stroke-width: 4;
        }

        .track {
            stroke: rgb(0 0 0 / 18%);
        }

        .progress {
            stroke: white;
            stroke-linecap: round;
        }

        .marker {
            fill: var(--color-neutrals-900, #171717);
        }

        .stat-card figcaption {
            grid-area: label;
            margin-block-start: 0.75rem;
            font: var(--body-sm);
            font-weight: 600;
            text-align: center;
            text-wrap: balance;
        }

        @container (max-width: 120px) {
            .stat-card::before {
                font-size: 22cqw;
            }

            .stat-card figcaption {
                font-size: 0.75rem;
            }
        }

        @media (max-width: 900px) {
            .experience-inner {
                grid-template-columns: minmax(0, 1fr);
                gap: 2.5rem;
            }

            .experience-content {
                max-width: 600px;
            }

            .experience-stats {
                gap: 1.5rem;
            }

            .stat-graphic {
                width: min(100%, 140px);
            }
        }

        @media (max-width: 500px) {
            .experience {
                margin-block-start: 4rem;
            }

            .experience-inner {
                gap: 2rem;
                padding: 2.5rem 1.25rem;
            }

            .experience-stats {
                gap: 0.75rem;
            }

            .stat-graphic {
                width: min(100%, 110px);
            }

            .stat-card figcaption {
                margin-block-start: 0.5rem;
            }
        }
    }
</style>
