---

---

<footer class="site-footer">
    <section
        class="newsletter"
        aria-labelledby="newsletter-title"
    >
        <div class="newsletter-inner">
            <p class="eyebrow">Stay updated</p>

            <h2 id="newsletter-title">Subscribe Our Newsletter</h2>

            <p class="newsletter-description">
                Build stronger Customer Relationships with Consultalk
            </p>

            <form
                class="newsletter-form"
                action="#"
                method="post"
            >
                <label
                    for="newsletter-email"
                    class="visually-hidden"
                >
                    Your email address
                </label>

                <input
                    id="newsletter-email"
                    name="email"
                    type="email"
                    placeholder="Your email address"
                    autocomplete="email"
                    required
                />

                <button type="submit">Subscribe</button>
            </form>
        </div>
    </section>

    <div class="footer-bottom">
        <a
            class="logo"
            href="/"
            aria-label="Consultalk – homepage"
        >
            Consultalk
        </a>

        <p class="copyright">Consultalk ©2026. All rights reserved.</p>

        <nav
            class="footer-navigation"
            aria-label="Footer navigation"
        >
            <a href="/terms">Terms of Service</a>
            <span aria-hidden="true">|</span>
            <a href="/privacy">Privacy Policy</a>
        </nav>
    </div>
</footer>

<style>
    @layer components {
        .site-footer {
            min-width: 0;
            background: var(--color-neutrals-900);
            color: var(--color-on-surface-elevated);
        }

        /* Newsletter */

        .newsletter {
            container-type: inline-size;
            min-width: 0;
        }

        .newsletter-inner {
            display: grid;
            justify-items: center;
            gap: var(--space-3);

            width: min(100%, 75rem);
            margin-inline: auto;
            padding: var(--space-6) 2rem;
            box-sizing: border-box;
            text-align: center;
        }

        .eyebrow,
        .newsletter-description,
        .newsletter-inner h2 {
            margin: 0;
        }

        .eyebrow {
            color: var(--color-action);
            font: var(--body-sm);
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
        }

        .newsletter-inner h2 {
            max-width: 100%;
            color: var(--color-on-surface-elevated);
            font-family: var(--font-cabin);
            font-size: clamp(1.5rem, 4cqi, 2.25rem);
            line-height: 1.2;
            text-wrap: balance;
        }

        .newsletter-description {
            max-width: 42rem;
            color: var(--color-text-muted);
            font: var(--body-lg);
            line-height: 1.6;
            text-wrap: pretty;
        }

        .newsletter-form {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: var(--space-2);

            width: min(100%, 30rem);
            margin-block-start: var(--space-2);
        }

        .newsletter-form input {
            flex: 1 1 12rem;
            min-width: 0;
            padding: 0.875rem 1rem;
            border: 1px solid var(--color-neutrals-400);
            border-radius: var(--radius-pill);
            box-sizing: border-box;
            background: var(--color-surface-primary);
            color: var(--color-text);
            font: var(--body-md);
        }

        .newsletter-form input::placeholder {
            color: var(--color-text-muted);
            opacity: 1;
        }

        .newsletter-form button {
            flex: 0 0 auto;
            padding: 0.875rem 1.5rem;
            border: 0;
            border-radius: var(--radius-pill);
            box-sizing: border-box;
            background: var(--color-action);
            color: var(--color-text);
            font: var(--button-sm);
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.2s ease;
        }

        .newsletter-form button:hover {
            opacity: 0.8;
        }

        .newsletter-form input:focus-visible,
        .newsletter-form button:focus-visible {
            outline: 2px solid var(--color-action);
            outline-offset: 4px;
        }

        /* Footer bottom */

        .footer-bottom {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
            align-items: center;
            gap: var(--space-4);

            width: min(100%, 75rem);
            min-width: 0;
            margin-inline: auto;
            padding: var(--space-5) 2rem;
            box-sizing: border-box;
            border-block-start: 1px solid rgb(255 255 255 / 12%);
        }

        .logo {
            justify-self: start;
            color: var(--color-action);
            font-family: var(--font-cabin);
            font-size: 1.25rem;
            font-weight: 700;
            line-height: 1;
            letter-spacing: -0.01em;
            white-space: nowrap;
            text-decoration: none;
            transition: opacity 0.2s ease;
        }

        .logo:hover {
            opacity: 0.85;
        }

        .copyright {
            margin: 0;
            color: var(--color-text-muted);
            font: var(--body-sm);
            text-align: center;
        }

        .footer-navigation {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            align-items: center;
            gap: 0.5rem;
            min-width: 0;
            color: var(--color-text-muted);
            font: var(--body-sm);
        }

        .footer-bottom a {
            color: inherit;
            text-decoration: none;
            text-underline-offset: 0.2em;
            transition: color 0.2s ease;
        }

        .footer-bottom a:hover {
            color: var(--color-action);
            text-decoration: underline;
        }

        .footer-bottom a:focus-visible {
            outline: 2px solid var(--color-action);
            outline-offset: 4px;
            border-radius: 4px;
        }

        /* Newsletter adapts to its available width */

        @container (max-width: 600px) {
            .newsletter-inner {
                padding: var(--space-6) 1.25rem;
            }

            .newsletter-description {
                max-width: 24rem;
                font: var(--body-md);
                line-height: 1.5;
            }

            .newsletter-form {
                flex-direction: column;
                align-items: stretch;
            }

            .newsletter-form input,
            .newsletter-form button {
                width: 100%;
                min-height: 3.25rem;
                box-sizing: border-box;
            }
        }

        /* Tablet */

        @media (max-width: 900px) {
            .footer-bottom {
                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
                row-gap: var(--space-4);
                padding-inline: 1.5rem;
            }

            .logo {
                justify-self: start;
            }

            .copyright {
                grid-column: 1 / -1;
                grid-row: 2;
            }

            .footer-navigation {
                justify-content: flex-end;
            }
        }

        /* Mobile */

        @media (max-width: 600px) {
            .newsletter-inner {
                padding: var(--space-6) 1rem;
            }

            .newsletter-inner h2 {
                max-width: 20ch;
                font-size: clamp(1.5rem, 7vw, 2rem);
            }

            .newsletter-description {
                max-width: 30rem;
                font-size: var(--body-md);
            }

            .newsletter-form {
                flex-direction: column;
                align-items: stretch;
                width: 100%;
            }

            .newsletter-form input,
            .newsletter-form button {
                flex: none;
                width: 100%;
                height: 3.25rem;
                min-height: 3.25rem;
                padding: 0.75rem 1rem;
                box-sizing: border-box;
            }

            .footer-bottom {
                grid-template-columns: minmax(0, 1fr);
                justify-items: center;
                gap: var(--space-3);
                padding: var(--space-5) 1rem;
                text-align: center;
            }

            .logo,
            .copyright,
            .footer-navigation {
                grid-column: auto;
                grid-row: auto;
                justify-self: center;
                max-width: 100%;
                text-align: center;
            }

            .footer-navigation {
                justify-content: center;
                column-gap: 0.5rem;
                row-gap: var(--space-2);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .newsletter-form button,
            .logo,
            .footer-bottom a {
                transition: none;
            }
        }
    }
</style>
