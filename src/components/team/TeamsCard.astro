---
import ArrowRight from "@icons/arrow--right.svg";
import type { TeamMember } from "@lib/api";

interface Props {
    team: TeamMember;
    variant?: "default" | "compact";
}

const { team, variant = "default" } = Astro.props;

// Henter SVG-filer som URL'er fra src/icons (bevaret fra oprindelig fil).
const iconFiles = import.meta.glob<string>("../../icons/*.svg", {
    eager: true,
    query: "?url",
    import: "default",
});

const instagramIcon = iconFiles["../../icons/instagram.svg"];
const facebookIcon = iconFiles["../../icons/facebook.svg"];

const profileUrl = `/team/${team.slug}`;

const instagramUrl =
    team.social_links?.find((link) => link.platform === "instagram")?.url ?? "#";
const facebookUrl =
    team.social_links?.find((link) => link.platform === "facebook")?.url ?? "#";
---

<article class:list={["team-card", variant === "compact" && "team-card--compact"]}>
    <a
        class="team-card-media"
        href={profileUrl}
        aria-label={variant === "compact" ? `Read more about ${team.name}` : team.name}
    >
        <img
            src={team.image.src}
            alt={team.image.alt}
            width={team.image.width}
            height={team.image.height}
            loading="lazy"
        />

        {
            variant !== "compact" && (
                <span class="team-card-title">{team.title}</span>
            )
        }
    </a>

    {
        variant !== "compact" && (
            <div class="team-card-body">
                <h3 class="team-card-name">{team.name}</h3>

                <p class="team-card-description">{team.description}</p>

                <div class="team-card-footer">
                    <a
                        class="read-more"
                        href={profileUrl}
                    >
                        Read more
                        <ArrowRight
                            class="arrow"
                            aria-hidden="true"
                        />
                    </a>

                    <div class="team-socials">
                        {instagramIcon && (
                            <a
                                href={instagramUrl}
                                aria-label="Instagram"
                            >
                                <img
                                    src={instagramIcon}
                                    alt=""
                                    width="16"
                                    height="16"
                                />
                            </a>
                        )}

                        {facebookIcon && (
                            <a
                                href={facebookUrl}
                                aria-label="Facebook"
                            >
                                <img
                                    src={facebookIcon}
                                    alt=""
                                    width="16"
                                    height="16"
                                />
                            </a>
                        )}
                    </div>
                </div>
            </div>
        )
    }
</article>

<style>
    .team-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    /* Billede (link) med grøn dekorativ boks */

    .team-card-media {
        position: relative;
        display: block;
        isolation: isolate;
        overflow: hidden;
        border-radius: 20px;
        color: inherit;
        text-decoration: none;
    }

    .team-card-media img {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 14px;
        transition: transform 0.3s ease;
    }

    .team-card-media:hover img {
        transform: scale(1.04);
    }

    .team-card-media:focus-visible {
        outline: 2px solid var(--color-text);
        outline-offset: 4px;
    }

    /* Titel på billedet */

    .team-card-title {
        position: absolute;
        z-index: 2;
        inset-inline: 1rem;
        inset-block-end: 1rem;
        padding: 0.4rem 0.9rem;
        border-radius: 999px;
        background: rgb(3 7 18 / 75%);
        color: var(--color-neutrals-50);
        font: var(--body-sm);
        font-weight: 600;
        text-align: center;
    }

    /* Navn og beskrivelse under billedet */

    .team-card-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
        padding: 1rem 0.25rem 0;
    }

    .team-card-name {
        margin: 0;
        color: var(--color-text);
        font: var(--heading-sm);
        letter-spacing: -0.01em;
    }

    .team-card-description {
        margin: 0;
        color: var(--color-text-muted);
        font: var(--body-md);
        line-height: 1.6;
    }

    /* Read more + sociale ikoner */

    .team-card-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: auto;
        padding-block-start: 0.75rem;
    }

    .read-more {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-text);
        font-weight: 700;
        text-decoration: none;
    }

    .read-more:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .read-more:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 4px;
        border-radius: 2px;
    }

    .read-more .arrow {
        flex: 0 0 1rem;
        width: 1rem;
        height: 1rem;
    }

    .team-socials {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .team-socials a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: var(--color-blue-700);
        transition: opacity 0.2s ease;
    }

    .team-socials a:hover {
        opacity: 0.8;
    }

    .team-socials a:focus-visible {
        outline: 2px solid var(--color-text);
        outline-offset: 3px;
    }

    .team-socials img {
        display: block;
        width: 16px;
        height: 16px;
        filter: brightness(0) invert(1);
    }

    /* Compact-varianten: kun billedet */

    .team-card--compact .team-card-media img {
        aspect-ratio: 4 / 5;
    }

    /* Responsivt – matcher team-gridets breakpoints */

    @media (max-width: 600px) {
        .team-card-media img {
            aspect-ratio: 4 / 3;
        }

        .team-card--compact .team-card-media img {
            aspect-ratio: 1 / 1;
        }

        .team-card-body {
            padding-inline: 0;
        }
    }
</style>

