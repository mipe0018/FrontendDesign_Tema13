---
import ArrowRight from "@icons/arrow--right.svg";
import ArrowLeft from "@icons/arrow-left.svg";
import FinancialCard from "@components/home/FinancialCard.astro";

interface FinancialItem {
    icon: string;
    title: string;
    description: string;
}

interface FinancialProjectionsResponse {
    eyebrow: string;
    title: string;
    subtitle: string;
    values: FinancialItem[];
}

const response = await fetch("https://ftk-api.pages.dev/financial-projections");

if (!response.ok) {
    throw new Error(
        `Kunne ikke hente financial projections: ${response.status}`,
    );
}

const financialData = (await response.json()) as FinancialProjectionsResponse;
---

<section
    class="financial-section"
    aria-labelledby="financial-title"
    data-financial-section
>
    <div class="financial-wrapper">
        <div class="financial-header">
            <div class="financial-text">
                <p class="eyebrow">{financialData.eyebrow}</p>

                <h2 id="financial-title">{financialData.title}</h2>

                <p class="financial-subtitle">{financialData.subtitle}</p>
            </div>

            <div
                class="carousel-buttons"
                aria-label="Styr kortene"
            >
                <button
                    type="button"
                    aria-label="Vis forrige kort"
                    aria-controls="financial-cards"
                    data-carousel-direction="previous"
                >
                    <ArrowLeft class="arrow" />
                </button>

                <button
                    type="button"
                    aria-label="Vis næste kort"
                    aria-controls="financial-cards"
                    data-carousel-direction="next"
                >
                    <ArrowRight class="arrow" />
                </button>
            </div>
        </div>
    </div>

    <div
        class="financial-cards"
        id="financial-cards"
        aria-label="Finansielle muligheder"
    >
        {
            financialData.values.map((financial) => (
                <div class="financial-card-wrapper">
                    <FinancialCard financial={financial} />
                </div>
            ))
        }
    </div>
</section>

<script>
    // Event delegation: virker også ved Astro-navigation
    // uden at tilføje nye click-listeners ved hver sidevisning.
    document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;

        const button = event.target.closest<HTMLButtonElement>(
            "[data-carousel-direction]",
        );

        if (!button) return;

        const section = button.closest("[data-financial-section]");
        const cards = section?.querySelector<HTMLElement>(".financial-cards");
        const card = cards?.querySelector<HTMLElement>(
            ".financial-card-wrapper",
        );

        if (!cards || !card) return;

        const styles = getComputedStyle(cards);
        const gap = parseFloat(styles.columnGap) || 0;
        const scrollDistance = card.getBoundingClientRect().width + gap;

        const direction = button.dataset.carouselDirection;

        cards.scrollBy({
            left: direction === "next" ? scrollDistance : -scrollDistance,
            behavior: "smooth",
        });
    });
</script>

<style>
    @layer components {
        .financial-section {
            grid-column: a / d;
            min-width: 0;
            margin-block-start: 8rem;
        }

        .financial-wrapper {
            width: min(75rem, 100%);
            margin-inline: auto;
        }

        .financial-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 2rem;
            margin-block-end: 2rem;
        }

        .financial-text {
            min-width: 0;
            max-width: 650px;
        }

        .financial-text .eyebrow {
            margin: 0;
            font: var(--body-sm);
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .financial-text h2 {
            margin: 0.5rem 0 1rem;
            font: var(--heading-lg);
            letter-spacing: -0.03em;
            text-wrap: balance;
        }

        .financial-subtitle {
            margin: 0;
            color: var(--color-text-muted);
            font: var(--body-lg);
            line-height: 1.6;
        }

        .carousel-buttons {
            display: flex;
            flex-shrink: 0;
            gap: 0.5rem;
        }

        .carousel-buttons button {
            display: grid;
            width: 3rem;
            height: 3rem;
            flex-shrink: 0;
            place-items: center;
            padding: 0;
            border: 0;
            border-radius: 50%;
            background-color: var(--color-blue-700);
            color: white;
            cursor: pointer;
            transition: opacity 160ms ease;
        }

        .carousel-buttons button:hover {
            opacity: 0.8;
        }

        .carousel-buttons button:focus-visible {
            outline: 3px solid currentColor;
            outline-offset: 3px;
        }

        .arrow {
            width: 1rem;
            height: 1rem;
        }

        .financial-cards {
            display: flex;
            width: 90vw;
            gap: 1rem;
            margin-inline-start: calc(50% - 45vw);
            overflow-x: auto;
            scroll-behavior: smooth;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
            overscroll-behavior-inline: contain;
        }

        .financial-cards::-webkit-scrollbar {
            display: none;
        }

        .financial-card-wrapper {
            flex: 0 0 calc((90vw - 3rem) / 4);
            min-width: 0;
            scroll-snap-align: start;
        }

        @media (max-width: 900px) {
            .financial-section {
                margin-block-start: 5rem;
            }

            .financial-wrapper {
                width: calc(100% - 6rem);
            }

            .financial-header {
                gap: 1.5rem;
            }

            .financial-cards {
                width: 100%;
                margin-inline-start: 0;
            }

            .financial-card-wrapper {
                flex-basis: calc((100% - 2rem) / 3);
            }
        }

        @media (max-width: 768px) {
            .financial-wrapper {
                width: 100%;
                box-sizing: border-box;
                padding-inline: 1.5rem;
            }

            .financial-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 1.5rem;
            }

            .financial-text {
                width: 100%;
                max-width: none;
            }

            .financial-text h2 {
                margin-block: 0.5rem 0.75rem;
            }

            .carousel-buttons button {
                width: 2.75rem;
                height: 2.75rem;
            }

            .financial-cards {
                width: 90vw;
                box-sizing: border-box;
                margin-inline-start: 0;
                padding-inline-start: 1.5rem;
                gap: 1rem;
            }

            .financial-card-wrapper {
                flex-basis: calc(90vw - 3rem);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .financial-cards {
                scroll-behavior: auto;
            }

            .carousel-buttons button {
                transition: none;
            }
        }
    }
</style>
