---
import "@styles/main.css";
import { Font } from "astro:assets";
import Header from "@components/global/Header.astro";
import Footer from "@components/global/Footer.astro";

interface Props {
  /**
   * Headeren leveres fælles af layoutet. Sæt til false på sider, der
   * bevidst ikke skal have den (f.eks. svgs.astro).
   */
  showHeader?: boolean;
  /**
   * Footeren leveres fælles af layoutet efter sidens indhold.
   * Sæt til false på sider, der bevidst ikke skal have den.
   */
  showFooter?: boolean;
}

const {
  showHeader = true,
  showFooter = true,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>AskExperts</title>
    <Font
      cssVariable="--font-cabin"
      preload
    />
    <Font
      cssVariable="--font-lato"
      preload
    />
    <style is:inline>
      @layer reset, global, tokens, components, overrides;
    </style>
  </head>
  <body>
    {showHeader && <Header />}
    <slot />
    {showFooter && <Footer />}
  </body>
</html>

<style></style>
