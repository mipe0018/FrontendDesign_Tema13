---
import ArrowRight from "@icons/arrow--right.svg";

interface ValueLink {
    text: string;
    url: string;
}

interface ValueItem {
    icon: string;
    title: string;
    description: string;
    link?: ValueLink;
}

interface Props {
    value: ValueItem;
    variant?: "default" | "alternative";
}

const { value, variant = "default" } = Astro.props;

// Henter SVG-filer som URL'er fra src/icons.
const iconFiles = import.meta.glob<string>("/src/icons/*.svg", {
    eager: true,
    query: "?url",
    import: "default",
});

const icon = iconFiles[`/src/icons/${value.icon}.svg`];
---

<article class:list={["values-card", `card-${variant}`]}>
    <div
        class="values-icon"
        aria-hidden="true"
    >
        {
            icon && (
                <img
                    src={icon}
                    alt=""
                    width="18"
                    height="18"
                />
            )
        }
    </div>

    <h3>{value.title}</h3>

    <p class="values-description">{value.description}</p>

    {
        value.link && (
            <a
                class="values-link"
                href={value.link.url}
            >
                {value.link.text}
                <ArrowRight
                    class="arrow"
                    aria-hidden="true"
                />
            </a>
        )
    }
</article>

<style>
    .values-card {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-height: 185px;
        padding: 1.25rem;
        border-radius: 12px;
        background-color: #f1f2f4;
    }

    .values-icon {
        display: flex;
        flex: 0 0 32px;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: var(--color-blue-700);
    }

    .values-icon img {
        display: block;
        width: 18px;
        height: 18px;
        filter: brightness(0) invert(1);
    }

    .values-card h3 {
        margin: 0;
        color: var(--color-text);
        font: var(--button-sm);
        letter-spacing: 0.5px;
    }

    .values-description {
        margin: 0;
        padding-bottom: 1rem;
        color: var(--color-text-muted);
        font: var(--body-lg);
        line-height: 1.6;
    }

    .values-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: auto;
        color: var(--color-text);
        font: var(--button-sm);
        letter-spacing: 0.5px;
        text-decoration: none;
    }

    .values-link:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .values-link:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 4px;
        border-radius: 2px;
    }

    .arrow {
        flex: 0 0 1rem;
        width: 1rem;
        height: 1rem;
    }
</style>
